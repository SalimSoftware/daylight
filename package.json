{
  "name": "daylight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup:local": "node scripts/install-local-dependencies.mjs",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/dev.mjs && DAYLIGHT_DEV=1 node dist-server/dev.mjs",
    "dev:web": "vite",
    "build": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs && vite build",
    "prestart": "npm run build",
    "start": "node dist-server/index.mjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "dotenv": "^16.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
