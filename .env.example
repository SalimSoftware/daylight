# Create OAuth credentials in Google Cloud, enable Google Calendar API,
# then set this redirect URI: http://localhost:8787/api/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/callback
# The URL the browser should return to after Google OAuth completes.
APP_URL=http://localhost:5173
PORT=8787

# Outlook / Microsoft 365 work accounts: use an IT-approved app registration.
# Platform: Mobile and desktop applications (public client, no client secret).
# Delegated Microsoft Graph permission: Calendars.ReadBasic.
MICROSOFT_CLIENT_ID=
# Prefer your company's directory (tenant) ID; organizations supports work accounts.
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/calendar/microsoft/callback
